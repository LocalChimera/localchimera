# Wiki / Knowledge Base submodules — KEPT for notetaking app
[submodule "upstream/llmwiki"]
	path = upstream/llmwiki
	url = https://github.com/lucasastorian/llmwiki.git
[submodule "upstream/openviking"]
	path = upstream/openviking
	url = https://github.com/volcengine/OpenViking.git
[submodule "upstream/otterwiki"]
	path = upstream/otterwiki
	url = https://github.com/redimp/otterwiki.git
[submodule "upstream/knowledge-catalog"]
	path = upstream/knowledge-catalog
	url = https://github.com/GoogleCloudPlatform/knowledge-catalog.git

# Tasking / mining network forks — KEPT
[submodule "upstream/btt-ai-miner"]
	path = upstream/btt-ai-miner
	url = https://github.com/BTT-AI-labs/miner-cli.git
[submodule "upstream/golem"]
	path = upstream/golem
	url = https://github.com/golemfactory/yagna.git
[submodule "upstream/anyone-protocol"]
	path = upstream/anyone-protocol
	url = https://github.com/anyone-protocol/ator-protocol.git
[submodule "upstream/mysterium"]
	path = upstream/mysterium
	url = https://github.com/mysteriumnetwork/node.git
[submodule "upstream/btfs"]
	path = upstream/btfs
	url = https://github.com/bittorrent/go-btfs.git

# Foundry lib
[submodule "lib/forge-std"]
	path = lib/forge-std
	url = https://github.com/foundry-rs/forge-std
