{
  "manifest_version": 3,
  "name": "Chimera Compute",
  "version": "0.1.0",
  "description": "Earn by sharing spare compute with the Widespread visitor-compute pool. Consent-first; revokes cleanly.",
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": ["https://huggingface.co/*"],
  "cross_origin_opener_policy": { "value": "same-origin" },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Chimera Compute" },
  "icons": {}
}
