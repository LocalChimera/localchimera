{
  "name": "@localchimera/analytics",
  "version": "1.0.0",
  "private": true,
  "description": "Chimera Analytics — privacy-first analytics with resource market dashboard",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tracker:build": "esbuild tracker/index.ts --bundle --format=esm --outfile=public/tracker.js --platform=browser --target=es2022",
    "dashboard:dev": "vite --config dashboard/vite.config.ts",
    "dashboard:build": "vite build --config dashboard/vite.config.ts",
    "build": "npm run tracker:build && npm run dashboard:build"
  },
  "dependencies": {
    "viem": "^2.54.6",
    "wagmi": "^2.14.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@tanstack/react-query": "^5.62.0",
    "@tremor/react": "^3.17.0",
    "connectkit": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^3.99.0"
  }
}
